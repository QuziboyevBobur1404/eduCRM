
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum PaymentMethod {
  CASH
  CLICK
}

enum NotificationType {
  PAYMENT_DUE
  PAYMENT_OVERDUE
  STUDENT_INACTIVE
  NEW_STUDENT
  EXAM_RESULT
  ATTENDANCE_ALERT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum Plan {
  STARTER
  GROWTH
  ENTERPRISE
}

model Tenant {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  plan         Plan      @default(STARTER)
  maxStudents  Int       @default(500)
  maxTeachers  Int       @default(20)
  maxBranches  Int       @default(1)
  features     Json      @default("{}")
  logoUrl      String?
  primaryColor String?
  isActive     Boolean   @default(true)
  trialEndsAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users     User[]
  students  Student[]
  teachers  Teacher[]
  courses   Course[]
  groups    Group[]
  payments  Payment[]
  exams     Exam[]
  settings  Setting[]

  @@map("tenants")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  avatar      String?
  role        Role      @default(TEACHER)
  tenantId    String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  teacher       Teacher?
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([email])
  @@index([tenantId, role])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model Teacher {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  speciality String?
  bio        String?
  salary     Decimal?  @db.Decimal(12, 2)
  joinedDate DateTime  @default(now())
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  groups Group[]

  @@index([tenantId])
  @@map("teachers")
}

model Student {
  id          String        @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  parentPhone String?
  address     String?
  avatar      String?
  birthDate   DateTime?
  gender      Gender
  joinedDate  DateTime      @default(now())
  status      StudentStatus @default(ACTIVE)
  notes       String?
  tenantId    String
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  groupStudents GroupStudent[]
  attendances   Attendance[]
  payments      Payment[]
  examResults   ExamResult[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([phone])
  @@map("students")
}

model Course {
  id           String    @id @default(uuid())
  name         String
  description  String?
  duration     Int
  level        String?
  monthlyPrice Decimal   @db.Decimal(12, 2)
  isActive     Boolean   @default(true)
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  groups Group[]

  @@index([tenantId])
  @@map("courses")
}

model Group {
  id         String    @id @default(uuid())
  name       String
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id])
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  capacity   Int       @default(15)
  roomNumber String?
  isActive   Boolean   @default(true)
  tenantId   String
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  students    GroupStudent[]
  schedules   Schedule[]
  attendances Attendance[]
  exams       Exam[]

  @@index([tenantId, isActive])
  @@index([teacherId])
  @@map("groups")
}

model GroupStudent {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)

  @@unique([groupId, studentId])
  @@index([studentId])
  @@index([groupId])
  @@map("group_students")
}

model Schedule {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@index([groupId])
  @@map("schedules")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  groupId   String
  group     Group            @relation(fields: [groupId], references: [id])
  date      DateTime
  status    AttendanceStatus
  lessonNum Int              @default(1)
  takenById String
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, groupId, date])
  @@index([studentId, date])
  @@index([groupId, date])
  @@map("attendances")
}

model Payment {
  id          String        @id @default(uuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])
  groupId     String
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("UZS")
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(PENDING)
  month       Int
  year        Int
  dueDate     DateTime
  paidAt      DateTime?
  receiptUrl  String?
  notes       String?
  tenantId    String
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([studentId, month, year])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("payments")
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  maxScore    Decimal  @db.Decimal(6, 2)
  date        DateTime
  description String?
  tenantId    String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  results ExamResult[]

  @@index([groupId])
  @@index([tenantId])
  @@map("exams")
}

model ExamResult {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  score     Decimal  @db.Decimal(6, 2)
  rank      Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@map("exam_results")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model File {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  uploadedById String
  tenantId     String
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("files")
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("settings")
}
